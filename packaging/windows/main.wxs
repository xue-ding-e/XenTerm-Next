<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX Toolset 3.14 installer definition for the XenTerm Windows desktop app
  (Flutter UI + the Rust core inside xenterm_bridge.dll).

  Built by apps/xenterm/tool/package_windows_installer.ps1, which passes:
    $(var.SourceDir)       staging directory with the Flutter release bundle
    $(var.ProductVersion)  MSI product version, three numeric fields (X.Y.Z)
    $(var.AppVersion)      the full app version (xt-vX.Y.Z, beta-..., ...)
    $(var.IconFile)        assets/xenterm.ico
    $(var.LicenseRtf)      packaging/windows/LICENSE.rtf
  and compiles the harvested file list from heat.exe as a second source file.

  This Next Flutter upgrade family is independent of upstream XenTerm and GPUI.
  Keep its UpgradeCode and shortcut component GUIDs stable across future releases.
  Per-user LocalAppData installation keeps the bridge's adjacent
  config-flutter-next profile writable without elevation. The profile is never
  harvested or deleted on uninstall. This recipe still needs Windows execution
  and install/upgrade/uninstall acceptance before enabling installer delivery.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Product
        Id="*"
        Name="XenTerm Next Flutter"
        Manufacturer="xenterm contributors"
        Language="1033"
        Codepage="1252"
        Version="$(var.ProductVersion)"
        UpgradeCode="D308C8B0-2E75-4F13-B4A8-7DD705095893">

        <Package
            Id="*"
            Keywords="Installer"
            Description="XenTerm Next Flutter - SSH/SFTP/terminal client (Flutter UI + Rust core)"
            Comments="$(var.AppVersion)"
            Manufacturer="xenterm contributors"
            InstallerVersion="500"
            Languages="1033"
            Compressed="yes"
            InstallScope="perUser"
            InstallPrivileges="limited"
            SummaryCodepage="1252"/>

        <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>

        <!--
          Major upgrade: a newer MSI replaces the older install in one
          transaction, uninstalling the old product with the same UpgradeCode.
          AllowSameVersionUpgrades lets a rebuilt beta MSI (same numeric
          version, new ProductCode) replace itself instead of failing with
          "another version is already installed".
        -->
        <MajorUpgrade
            Schedule="afterInstallInitialize"
            AllowSameVersionUpgrades="yes"
            DowngradeErrorMessage="A newer version of XenTerm Next Flutter is already installed. Setup will now exit."/>

        <Icon Id="ProductICO" SourceFile="$(var.IconFile)"/>
        <Property Id="ARPPRODUCTICON" Value="ProductICO"/>

        <!-- Do not close processes by the shared xenterm.exe basename: that
             could affect GPUI or upstream. Windows Installer handles files in
             this product; users must close this installation before upgrading. -->

        <!-- Populate Programs and Features -> Install location. -->
        <Property Id="ARPINSTALLLOCATION" Secure="yes"/>
        <!-- INSTALLFOLDER is the public directory property; Secure makes a
             silent override (msiexec /i ... INSTALLFOLDER=...) survive the
             installer UI boundary too. -->
        <Property Id="INSTALLFOLDER" Secure="yes"/>
        <!-- MSI does not persist a command-line directory override by itself.
             Recover it before costing for upgrade/repair/uninstall; an explicit
             new INSTALLFOLDER still takes precedence. Never search GPUI keys. -->
        <Property Id="PREVIOUSINSTALLFOLDER" Secure="yes">
            <RegistrySearch Id="FindFlutterInstallLocation" Root="HKCU"
                Key="Software\XenTerm-Next\Flutter" Name="InstallLocation"
                Type="raw" Win64="yes"/>
        </Property>
        <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]"
            Before="CostInitialize" Sequence="both">NOT INSTALLFOLDER AND PREVIOUSINSTALLFOLDER</SetProperty>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="LocalAppDataFolder">
                <Directory Id="INSTALLFOLDER" Name="XenTerm Next Flutter"
                    ComponentGuidGenerationSeed="C548E41D-C5EE-4F4E-9F8A-6CE16261AFEF"/>
            </Directory>
            <!-- Per-user Start Menu shortcut with an independent HKCU keypath. -->
            <Directory Id="ProgramMenuFolder">
                <Directory Id="XenTermMenuFolder" Name="XenTerm Next Flutter">
                    <Component Id="StartMenuShortcut" Guid="{135D4B2E-181F-4213-B52B-108C12763A33}">
                        <Shortcut Id="XenTermStartMenuShortcut"
                            Name="XenTerm Next Flutter"
                            Description="XenTerm Next Flutter - SSH/SFTP/terminal client"
                            Target="[INSTALLFOLDER]xenterm.exe"
                            WorkingDirectory="INSTALLFOLDER"
                            Icon="ProductICO"/>
                        <RemoveFolder Id="RemoveXenTermMenuFolder" On="uninstall"/>
                        <RegistryValue Root="HKCU"
                            Key="Software\XenTerm-Next\Flutter"
                            Name="StartMenuShortcut"
                            Type="integer"
                            Value="1"
                            KeyPath="yes"/>
                    </Component>
                </Directory>
            </Directory>
            <!-- Per-user desktop shortcut; never owns the upstream shortcut. -->
            <Directory Id="DesktopFolder">
                <Component Id="DesktopShortcut" Guid="{378C47BD-20D6-4222-A18B-2D8B45CE7B36}">
                    <Shortcut Id="XenTermDesktopShortcut"
                        Name="XenTerm Next Flutter"
                        Description="XenTerm Next Flutter - SSH/SFTP/terminal client"
                        Target="[INSTALLFOLDER]xenterm.exe"
                        WorkingDirectory="INSTALLFOLDER"
                        Icon="ProductICO"/>
                    <RegistryValue Root="HKCU"
                        Key="Software\XenTerm-Next\Flutter"
                        Name="DesktopShortcut"
                        Type="integer"
                        Value="1"
                        KeyPath="yes"/>
                </Component>
            </Directory>
        </Directory>

        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="InstallLocation" Guid="{327A1B30-18D7-4656-85F0-204C94E61038}" Win64="yes">
                <RegistryValue Root="HKCU" Key="Software\XenTerm-Next\Flutter"
                    Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes"/>
            </Component>
        </DirectoryRef>

        <!-- ComponentGroup "XenTermFiles" comes from heat.exe (harvested bundle). -->
        <Feature Id="MainProgram" Title="XenTerm Next Flutter" Level="1">
            <ComponentGroupRef Id="XenTermFiles"/>
            <ComponentRef Id="InstallLocation"/>
            <ComponentRef Id="StartMenuShortcut"/>
            <ComponentRef Id="DesktopShortcut"/>
        </Feature>

        <CustomAction Id="SetARPInstallLocation"
            Property="ARPINSTALLLOCATION"
            Value="[INSTALLFOLDER]"
            Execute="immediate"/>
        <InstallExecuteSequence>
            <Custom Action="SetARPInstallLocation" After="CostFinalize">NOT REMOVE</Custom>
        </InstallExecuteSequence>

        <!-- Installer wizard: Welcome, License, install-folder picker, Ready,
             Progress, Finish. WixUI_InstallDir needs WIXUI_INSTALLDIR; the
             license page reads WixUILicenseRtf. -->
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER"/>
        <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)"/>
        <UIRef Id="WixUI_InstallDir"/>
        <UIRef Id="WixUI_ErrorProgressText"/>
    </Product>
</Wix>
