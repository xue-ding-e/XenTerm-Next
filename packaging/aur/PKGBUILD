# Maintainer: ixbaicn <REPLACE_WITH_YOUR_EMAIL>
#
# Binary package: installs the pre-built desktop application (Flutter UI +
# Rust core) from the GitHub release tarball, so Arch users don't have to
# compile Rust + Flutter themselves. The CI in
# .github/workflows/aur-publish.yml keeps pkgver + checksums in sync on each
# release; you can also `makepkg -si` this file directly.
pkgname=xenterm-bin
pkgver=0.7.3
pkgrel=1
pkgdesc="Lightweight FinalShell-style SSH/SFTP/terminal client (Rust core + Flutter UI)"
arch=('x86_64')
url="https://github.com/ixbaicn/XenTerm"
license=('MIT')
provides=('xenterm')
conflicts=('xenterm')
# The desktop bundle is self-contained (Flutter engine + bridge library);
# GTK3 is the toolkit the runner links against.
depends=('gtk3' 'hicolor-icon-theme')
options=('!strip')
source_x86_64=("xenterm-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/xenterm-v${pkgver}-linux-x86_64-desktop.tar.gz")
# `updpkgsums` (run by CI, or by you locally) fills these in. SKIP just disables
# the integrity check for a manual build.
sha256sums_x86_64=('SKIP')

package() {
    # The tarball extracts to xenterm-v<ver>-linux-x86_64-desktop/ and runs in
    # place, so the whole bundle goes to /opt and a symlink exposes the binary.
    local _dir="${srcdir}/xenterm-v${pkgver}-linux-x86_64-desktop"
    install -d "${pkgdir}/opt/xenterm"
    cp -a "${_dir}/." "${pkgdir}/opt/xenterm/"
    chmod 755 "${pkgdir}/opt/xenterm/xenterm"
    install -Dm755 /dev/null "${pkgdir}/usr/bin/xenterm"
    ln -sf /opt/xenterm/xenterm "${pkgdir}/usr/bin/xenterm"
    install -Dm644 "${_dir}/xenterm.desktop" "${pkgdir}/usr/share/applications/xenterm.desktop"
    install -Dm644 "${_dir}/icon@512.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/xenterm.png"
    install -Dm644 "${_dir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 "${_dir}/THIRD_PARTY_NOTICES.md" "${pkgdir}/usr/share/doc/${pkgname}/THIRD_PARTY_NOTICES.md"
}
