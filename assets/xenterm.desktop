[Desktop Entry]
Type=Application
Name=XenTerm
GenericName=SSH Client
Comment=SSH, SFTP and terminal client with a Rust core
Comment[zh_CN]=Rust 核心的 SSH / SFTP / 终端客户端
Exec=xenterm
Icon=xenterm
Terminal=false
# Network is the single freedesktop main category; the remaining category is
# an additional hint. Multiple main categories can make GNOME app-grid
# indexing inconsistent on Ubuntu 26.04.
Categories=Network;TerminalEmulator;
Keywords=ssh;sftp;terminal;shell;
StartupNotify=true
StartupWMClass=xenterm
