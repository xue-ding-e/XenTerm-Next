+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn spans(ranges: &[Range<usize>]) -> Vec<(Range<usize>, Hsla)> {
+        ranges
+            .iter()
+            .cloned()
+            .map(|r| (r, gpui::black()))
+            .collect()
+    }
+
+    #[test]
+    fn accepts_utf8_boundaries_and_fills_visible_gaps() {
+        let text = Rope::from_str("é x 中文");
+        let styles = TextColors::new("é x 中文", &text, spans(&[0..2, 5..11])).unwrap();
+        let visible = styles.visible(&text, 2..8).unwrap();
+        assert_eq!(visible.into_iter().map(|(r, _)| r).collect::<Vec<_>>(), vec![2..5, 5..8]);
+        assert!(styles.visible(&text, 1..8).is_none());
+        assert!(styles.visible(&text, 0..12).is_none());
+    }
+
+    #[test]
+    fn foreground_colors_do_not_override_font_or_decoration_properties() {
+        let text = Rope::from_str("écho");
+        assert_eq!(text.len(), "écho".len());
+        let colors = TextColors::new("écho", &text, spans(&[0..5])).unwrap();
+        let runs = colors.visible(&text, 0..5).unwrap();
+        assert_eq!(runs[0].1, HighlightStyle {
+            color: Some(gpui::black()),
+            ..Default::default()
+        });
+    }
+
+    #[test]
+    fn rejects_invalid_ranges_without_sorting_or_clamping() {
+        let text = Rope::from_str("é xyz");
+        for invalid in [vec![0..1], vec![1..2], vec![0..7], vec![3..3], vec![4..3], vec![3..5, 2..3], vec![2..5, 4..6]] {
+            assert!(TextColors::new("é xyz", &text, spans(&invalid)).is_none());
+        }
+    }
+
+    #[test]
+    fn ignores_stale_same_length_and_changed_length_values() {
+        let original = Rope::from_str("echo x");
+        let styles = TextColors::new("echo x", &original, spans(&[0..4])).unwrap();
+        for changed in ["echo y", "echo longer"] {
+            let current = Rope::from_str(changed);
+            assert!(styles.visible(&current, 0..4).is_none());
+            assert!(TextColors::new("echo x", &current, spans(&[0..4])).is_none());
+        }
+    }
+
+    #[test]
+    fn maximum_size_snapshot_produces_bounded_complete_runs() {
+        let source = "a".repeat(MAX_SOURCE_BYTES);
+        let current = Rope::from_str(&source);
+        let ranges = (0..MAX_SPANS).map(|ix| (ix * 16)..(ix * 16 + 1)).collect::<Vec<_>>();
+        let colors = TextColors::new(&source, &current, spans(&ranges)).unwrap();
+        let started = std::time::Instant::now();
+        for _ in 0..100 {
+            let runs = colors.visible(&current, 0..MAX_SOURCE_BYTES).unwrap();
+            assert!(runs.len() <= MAX_SPANS * 2 + 1);
+            assert_eq!(runs.first().unwrap().0.start, 0);
+            assert_eq!(runs.last().unwrap().0.end, MAX_SOURCE_BYTES);
+            assert_eq!(runs.iter().map(|(range, _)| range.len()).sum::<usize>(), MAX_SOURCE_BYTES);
+            assert!(runs.windows(2).all(|pair| pair[0].0.end == pair[1].0.start));
+        }
+        eprintln!("100 maximum-size text-color projections: {:?}", started.elapsed());
+    }
+
+    #[test]
+    fn bounds_source_and_span_count_and_accepts_empty_styles() {
+        let source = "a".repeat(MAX_SOURCE_BYTES + 1);
+        assert!(TextColors::new(&source, &Rope::from_str(&source), vec![]).is_none());
+        let source = "a".repeat(MAX_SPANS + 1);
+        let ranges = (0..source.len()).map(|ix| ix..ix + 1).collect::<Vec<_>>();
+        assert!(TextColors::new(&source, &Rope::from_str(&source), spans(&ranges)).is_none());
+        assert!(TextColors::new("", &Rope::new(), vec![]).is_some());
+        let text = Rope::from_str("plain");
+        let styles = TextColors::new("plain", &text, vec![]).unwrap();
+        assert_eq!(styles.visible(&text, 0..5).unwrap()[0].0, 0..5);
+    }
