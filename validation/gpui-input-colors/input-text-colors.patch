+    /// Set application-owned foreground colors for the single-line input's text.
+    ///
+    /// `source` must exactly match the current value. Ranges are UTF-8 byte
+    /// offsets into `source`, ordered, nonempty, nonoverlapping, and on character
+    /// boundaries. Gaps retain the input's ordinary style. At most 4096 spans
+    /// and 64 KiB of source text are accepted to bound validation and painting.
+    ///
+    /// Returns `false` and clears previous styles for invalid or stale input,
+    /// or when the input is masked. Painting also checks the current text, so
+    /// edits never reuse styles computed for a different value. Applications
+    /// should recompute after changes and theme changes, including programmatic
+    /// value changes that do not emit `InputEvent::Change`. Actual text changes
+    /// and enabling masking drop the snapshot; a later edit back cannot revive
+    /// it. Rejected edits and operations ending with identical text preserve
+    /// the previous snapshot. No-op `set_value` therefore keeps its colors.
+    /// Colors do not modify
+    /// the text, selection, undo history, IME composition, or input events.
+    ///
+    /// Foreground boundaries can split font-shaping runs in the underlying
+    /// renderer. Ligatures and complex-script geometry require verification;
+    /// accepting only colors does not itself guarantee identical glyph widths.
+    pub fn set_text_colors(
+        &mut self,
+        source: &str,
+        spans: Vec<(std::ops::Range<usize>, gpui::Hsla)>,
+        cx: &mut Context<Self>,
+    ) -> bool {
+        self.text_colors = (!self.masked)
+            .then(|| super::text_colors::TextColors::new(source, &self.text, spans))
+            .flatten()
+            .map(Box::new);
+        let accepted = self.text_colors.is_some();
+        cx.notify();
+        accepted
+    }
+
