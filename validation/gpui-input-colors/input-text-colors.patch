+// Modified 2026-11-03: prototype single-line foreground coloring and regressions.
+//! Bounded, application-owned foreground colors for ordinary single-line inputs.
+//!
+//! This is presentation only: editing remains owned by InputState. Keeping the
+//! exact source value prevents delayed highlighting from decorating newer text.
+use std::ops::Range;
+
+use gpui::{HighlightStyle, Hsla};
+use ropey::Rope;
+
+const MAX_SOURCE_BYTES: usize = 64 * 1024;
+const MAX_SPANS: usize = 4096;
+
+pub(super) struct TextColors {
+    source: String,
+    spans: Vec<(Range<usize>, Hsla)>,
+}
+
+impl TextColors {
+    pub(super) fn new(
+        source: &str,
+        current: &Rope,
+        spans: Vec<(Range<usize>, Hsla)>,
+    ) -> Option<Self> {
+        if source.len() > MAX_SOURCE_BYTES
+            || spans.len() > MAX_SPANS
+            || !same_text(source, current)
+        {
+            return None;
+        }
+        let mut previous_end = 0;
+        for (range, _) in &spans {
+            if range.start < previous_end
+                || range.start >= range.end
+                || range.end > source.len()
+                || !source.is_char_boundary(range.start)
+                || !source.is_char_boundary(range.end)
+            {
+                return None;
+            }
+            previous_end = range.end;
+        }
+        Some(Self {
+            source: source.to_owned(),
+            spans,
+        })
+    }
+
+    /// Supply complete ordered runs, including default styles in the gaps.
+    /// Invalid UTF-8 visibility boundaries are ignored rather than slicing a scalar.
+    pub(super) fn visible(
+        &self,
+        current: &Rope,
+        range: Range<usize>,
+    ) -> Option<Vec<(Range<usize>, HighlightStyle)>> {
+        if !same_text(&self.source, current)
+            || range.start >= range.end
+            || range.end > self.source.len()
+            || !self.source.is_char_boundary(range.start)
+            || !self.source.is_char_boundary(range.end)
+        {
+            return None;
+        }
+        let mut result = Vec::new();
+        let mut cursor = range.start;
+        for (span, color) in &self.spans {
+            let start = span.start.max(range.start);
+            let end = span.end.min(range.end);
+            if start >= end {
+                continue;
+            }
+            if cursor < start {
+                result.push((cursor..start, HighlightStyle::default()));
+            }
+            result.push((
+                start..end,
+                HighlightStyle {
+                    color: Some(*color),
+                    ..Default::default()
+                },
+            ));
+            cursor = end;
+        }
+        if cursor < range.end {
+            result.push((cursor..range.end, HighlightStyle::default()));
+        }
+        Some(result)
+    }
+}
+
+fn same_text(source: &str, current: &Rope) -> bool {
+    // Rope 2 uses byte offsets and byte length, as does the input renderer.
+    current.len() == source.len() && current.chars().eq(source.chars())
+}
