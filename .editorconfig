root = true

# XenTerm is UTF-8, LF, final-newline. Windows checkouts rely on
# core.autocrlf=true; the committed content is LF.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{rs,toml}]
indent_size = 4

[*.{dart,yaml,yml,json,jsonc}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
