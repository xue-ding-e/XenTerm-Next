/target
# Cargo.lock is deliberately tracked: xenterm is a binary application crate,
# so the lockfile is what makes release builds reproducible. Cargo.toml carries
# security-motivated pins (russh 0.61, see RUSTSEC-2026-0154) that only mean
# something if the resolved graph is committed.
/output
*.rs.bk
.DS_Store
/.vscode
/.idea
# Local AI assistant state: never part of the repository.
/.claude
/.codegraph
/.qoder
/.zcode
/.zcodeignore
/opencode.jsonc
/docs/superpowers

# Test fixtures create ephemeral keys/profiles at runtime, never in source.
__pycache__/
*.pyc
target-gnu/
# Regenerated by scripts/version.sh on every build (版本号规范 v1 §6); shipped
# inside release artifacts but never committed — each build has its own.
/version.json
