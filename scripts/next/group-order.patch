+    store.add_group("Alpha".into());
+    assert_eq!(store.ordered_session_groups(), names(&["zULU", "Alpha"]));
+    store.save().unwrap();
+    assert_eq!(
+        reopen(&store).ordered_session_groups(),
+        names(&["zULU", "Alpha"])
