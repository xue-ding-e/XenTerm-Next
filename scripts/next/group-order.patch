+        .unwrap();
+    store.rename_group("Zulu", "zULU".into());
+    assert_eq!(store.ordered_session_groups(), names(&["zULU", "Alpha"]));
+    assert_eq!(store.cache.collapsed_session_groups, Some(names(&["zULU"])));
