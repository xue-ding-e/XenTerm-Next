+// Equivalent to str::ceil_char_boundary without requiring a newer Rust MSRV.
+fn ceil_utf8_boundary(text: &str, index: usize) -> usize {
+    let mut boundary = index.min(text.len());
+    while !text.is_char_boundary(boundary) {
+        boundary += 1;
+    }
+    boundary
+}
