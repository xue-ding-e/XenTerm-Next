<?xml version="1.0" encoding="windows-1252"?>
<!--
  WiX (v3) installer definition for xenterm, driven by `cargo wix`.

  cargo-wix injects these preprocessor variables:
    $(var.Version)            crate version from Cargo.toml
    $(var.CargoTargetBinDir)  e.g. target\x86_64-pc-windows-msvc\release

  The `WixUI_FeatureTree` UI (bottom) provides optional integration features
  and a "Browse..." button for the selected main feature. AppSearch
  restores the previous XenTerm location before that page is shown; a value
  pointing into a pre-rename "meatshell" folder is discarded (see
  IgnorePreRenameRestoreLocation below), so the wizard falls back to the
  Program Files default.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Product
        Id="*"
        Name="xenterm"
        UpgradeCode="6E8F2A1B-3C4D-4E5F-9A0B-1C2D3E4F5A6B"
        Manufacturer="xenterm contributors"
        Language="1033"
        Codepage="1252"
        Version="$(var.Version)">

        <Package Id="*"
            Keywords="Installer"
            Description="xenterm - lightweight Rust + GPUI SSH/terminal client"
            Manufacturer="xenterm contributors"
            InstallerVersion="450"
            Languages="1033"
            Compressed="yes"
            InstallScope="perMachine"
            SummaryCodepage="1252"/>

        <!-- Replace an older install in place instead of erroring out. -->
        <MajorUpgrade
            Schedule="afterInstallInitialize"
            MigrateFeatures="yes"
            DowngradeErrorMessage="A newer version of xenterm is already installed. Setup will now exit."/>

        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1"/>
        <Property Id="DiskPrompt" Value="xenterm Installation"/>

        <!--
          A stdio MCP client can keep `xenterm.exe mcp serve` alive after the
          GUI has closed. Windows cannot replace a running executable during a
          major upgrade, so give the user an explicit Abort/Retry/Ignore prompt.
          Retry lets them close the MCP host cleanly; Ignore closes ordinary GUI
          windows first and, after the timeout, terminates a windowless MCP copy.
          This is intentionally upgrade-only: a first install has no old binary.
        -->
        <util:CloseApplication
            Id="CloseRunningXenTermForUpgrade"
            Target="xenterm.exe"
            Description="XenTerm or its MCP server is still running. Close XenTerm and any MCP client using it, then click Retry. Choose Ignore to close it automatically."
            PromptToContinue="yes"
            CloseMessage="yes"
            ElevatedCloseMessage="yes"
            Timeout="10"
            TerminateProcess="0"
            RebootPrompt="no">WIX_UPGRADE_DETECTED</util:CloseApplication>

        <!--
          The pre-rename binary. An upgrade from a meatshell install (same
          UpgradeCode, so MSI replaces it in place) must also be able to close
          the old executable, or it blocks the upgrade exactly like above.
        -->
        <util:CloseApplication
            Id="CloseRunningMeatShellForUpgrade"
            Target="meatshell.exe"
            Description="MeatShell (pre-rename XenTerm) or its MCP server is still running. Close it and any MCP client using it, then click Retry. Choose Ignore to close it automatically."
            PromptToContinue="yes"
            CloseMessage="yes"
            ElevatedCloseMessage="yes"
            Timeout="10"
            TerminateProcess="0"
            RebootPrompt="no">WIX_UPGRADE_DETECTED</util:CloseApplication>

        <Icon Id="ProductICO" SourceFile="assets\xenterm.ico"/>
        <Property Id="ARPPRODUCTICON" Value="ProductICO"/>

        <!--
          Preserve a custom install location across major upgrades (#293).
          Only the value this package writes itself (Software\xenterm\InstallDir,
          component below) is honored. The pre-rename sources — the
          Software\meatshell registry key and the v0.6.5-v0.6.7 component
          search — are deliberately gone: resurrecting the old brand's folder
          made fresh installs default to e.g. D:\Program Files\meatshell on
          machines that had it. Transitional builds also copied the meatshell
          path into Software\xenterm\InstallDir, so the restored value is
          additionally screened by IgnorePreRenameRestoreLocation below.
        -->
        <Property Id="APPLICATIONFOLDER" Secure="yes">
            <RegistrySearch Id="PreviousInstallDirRegistry"
                Root="HKLM"
                Key="Software\xenterm"
                Name="InstallDir"
                Type="directory"
                Win64="yes"/>
        </Property>

        <!--
          Transitional installers could persist the pre-rename meatshell
          folder under Software\xenterm as well. Drop any restored value that
          still points into a meatshell folder so both the wizard and silent
          installs fall back to the default location; the registry value is
          overwritten with the real folder on the next install.
        -->
        <CustomAction Id="IgnorePreRenameRestoreLocation"
            Property="APPLICATIONFOLDER"
            Value="[ProgramFiles64Folder]xenterm\"
            Execute="immediate"/>
        <InstallUISequence>
            <Custom Action="IgnorePreRenameRestoreLocation" After="AppSearch">APPLICATIONFOLDER &gt;&lt; "meatshell"</Custom>
        </InstallUISequence>
        <InstallExecuteSequence>
            <Custom Action="IgnorePreRenameRestoreLocation" After="AppSearch">APPLICATIONFOLDER &gt;&lt; "meatshell"</Custom>
        </InstallExecuteSequence>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <!-- Default path; the InstallDir UI lets the user change it. -->
                <Directory Id="APPLICATIONFOLDER" Name="xenterm">
                    <Component Id="MainExecutable"
                               Guid="{ECB1F8D7-7CC7-5A8A-A7CC-56A267A502DC}">
                        <File Id="xentermEXE"
                              Name="xenterm.exe"
                              Source="$(var.CargoTargetBinDir)\xenterm.exe"
                              KeyPath="yes"/>
                    </Component>
                    <!-- MSI edits only this PATH entry, leaving all other entries intact.
                         The component also removes its own entry on uninstall. -->
                    <Component Id="CommandLinePath"
                               Guid="{8A3FD217-786F-4B11-8D96-7BA8965ACFE4}"
                               Win64="yes">
                        <Environment Id="CommandLinePathEntry" Name="PATH"
                            Value="[APPLICATIONFOLDER]" Action="set" Part="last"
                            System="yes" Permanent="no"/>
                        <RegistryValue Root="HKLM" Key="Software\xenterm"
                            Name="commandLinePath" Type="integer" Value="1" KeyPath="yes"/>
                    </Component>
                    <Component Id="ThirdPartyNotices" Guid="*">
                        <File Id="thirdPartyNoticesFile"
                              Name="THIRD_PARTY_NOTICES.md"
                              Source="THIRD_PARTY_NOTICES.md"
                              KeyPath="yes"/>
                    </Component>
                    <Component Id="InstallLocationRegistry"
                               Guid="{E6877B59-AD5C-4CA3-A1F5-8F8E0CC6CC53}"
                               Win64="yes">
                        <RegistryValue Root="HKLM"
                            Key="Software\xenterm"
                            Name="InstallDir"
                            Type="string"
                            Value="[APPLICATIONFOLDER]"
                            KeyPath="yes"/>
                    </Component>
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Component Id="ApplicationShortcut" Guid="*">
                    <Shortcut Id="StartMenuShortcut"
                        Name="xenterm"
                        Description="Lightweight SSH/terminal client"
                        Target="[APPLICATIONFOLDER]xenterm.exe"
                        WorkingDirectory="APPLICATIONFOLDER"
                        Icon="ProductICO"/>
                    <RemoveFolder Id="CleanUpShortCut" On="uninstall"/>
                    <RegistryValue Root="HKCU"
                        Key="Software\xenterm"
                        Name="installed"
                        Type="integer"
                        Value="1"
                        KeyPath="yes"/>
                </Component>
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop">
                <Component Id="DesktopShortcut"
                           Guid="{A034B952-E060-47C3-8D04-FCA147FBE3E5}">
                    <Shortcut Id="DesktopShortcutLink"
                        Name="xenterm"
                        Description="Lightweight SSH/terminal client"
                        Target="[APPLICATIONFOLDER]xenterm.exe"
                        WorkingDirectory="APPLICATIONFOLDER"
                        Icon="ProductICO"/>
                    <RegistryValue Root="HKCU"
                        Key="Software\xenterm"
                        Name="desktopShortcut"
                        Type="integer"
                        Value="1"
                        KeyPath="yes"/>
                </Component>
            </Directory>
        </Directory>

        <!-- Stable feature IDs let MSI migrate user choices across major upgrades.
             Silent installs can select only MainProgram with ADDLOCAL=MainProgram. -->
        <Feature Id="MainProgram" Title="xenterm" Level="1"
                 Description="Application files. Select this item to change the installation folder."
                 ConfigurableDirectory="APPLICATIONFOLDER" Absent="disallow"
                 AllowAdvertise="no" Display="expand">
            <ComponentRef Id="MainExecutable"/>
            <ComponentRef Id="ThirdPartyNotices"/>
            <ComponentRef Id="InstallLocationRegistry"/>
            <Feature Id="CommandLineIntegration" Title="Add XenTerm to PATH" Level="1"
                     Description="Run xenterm from new terminals and CLI/MCP clients. Existing terminals may need to restart."
                     AllowAdvertise="no">
                <ComponentRef Id="CommandLinePath"/>
            </Feature>
            <Feature Id="StartMenuIntegration" Title="Create Start menu shortcut" Level="1"
                     Description="Add XenTerm to the Windows Start menu." AllowAdvertise="no">
                <ComponentRef Id="ApplicationShortcut"/>
            </Feature>
            <Feature Id="DesktopIntegration" Title="Create desktop shortcut" Level="1"
                     Description="Add a XenTerm shortcut to the desktop." AllowAdvertise="no">
                <ComponentRef Id="DesktopShortcut"/>
            </Feature>
        </Feature>

        <!-- Populate Programs and Features -> InstallLocation as well. -->
        <CustomAction Id="SetARPInstallLocation"
            Property="ARPINSTALLLOCATION"
            Value="[APPLICATIONFOLDER]"
            Execute="immediate"/>
        <InstallExecuteSequence>
            <Custom Action="SetARPInstallLocation" After="CostFinalize">NOT REMOVE</Custom>
        </InstallExecuteSequence>

        <!-- Native MSI feature selection: all integrations selected initially,
             deselectable and repairable; MainProgram retains the Browse button. -->
        <UIRef Id="WixUI_FeatureTree"/>
        <UIRef Id="WixUI_ErrorProgressText"/>
    </Product>
</Wix>
