<?xml version="1.0" encoding="utf-8"?>
<!-- Independent Next identity. Never migrate/remove upstream's machine-wide
     product or Flutter. ProductCode changes per build; UpgradeCode is permanent.
     Harvest the complete verified portable bundle, not just its executable. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="XenTerm-Next GPUI" Manufacturer="xenterm contributors"
           Language="1033" Codepage="1252" Version="$(var.ProductVersion)"
           UpgradeCode="7548A7CB-F70B-4AE7-A5F0-F952D45AA826">
    <Package Id="*" InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             InstallPrivileges="limited" Description="XenTerm-Next GPUI SSH/terminal client"
             Comments="$(var.RuntimeVersion); source $(var.SourceSha); unsigned"/>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer XenTerm-Next GPUI is already installed."/>
    <!-- Reject same timestamp builds with different ProductCodes too. Repair
         of the already installed ProductCode remains possible (Installed). -->
    <Upgrade Id="7548A7CB-F70B-4AE7-A5F0-F952D45AA826">
      <UpgradeVersion Minimum="$(var.ProductVersion)" IncludeMinimum="yes"
        OnlyDetect="yes" Property="SAMEORNEWERFOUND"/>
    </Upgrade>
    <Condition Message="This or a newer GPUI build is installed. Use Repair for the installed build.">Installed OR NOT SAMEORNEWERFOUND</Condition>
    <!-- Restart Manager acts on owned files. Do not terminate xenterm.exe by
         name: Flutter, upstream and portable copies can run alongside GPUI. -->
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallDirectory" Root="HKCU"
        Key="Software\XenTerm-Next\GPUI\Installer" Name="InstallDir" Type="raw" Win64="yes"/>
    </Property>
    <Icon Id="ProductIcon" SourceFile="$(var.IconFile)"/>
    <Property Id="ARPPRODUCTICON" Value="ProductIcon"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="UserProgramsFolder" Name="Programs">
          <Component Id="ProgramsCleanup" Guid="A298CF90-4C31-477B-8DD6-C150DAB84275" Win64="yes">
            <RemoveFolder Id="RemoveEmptyPrograms" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\XenTerm-Next\GPUI\Installer"
              Name="ProgramsFolder" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
          <Directory Id="INSTALLFOLDER" Name="XenTerm-Next GPUI"/>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProductMenu" Name="XenTerm-Next GPUI">
          <Component Id="MenuShortcut" Guid="D709397F-8547-4610-B202-2D63433D242F" Win64="yes">
            <Shortcut Id="MenuLink" Name="XenTerm-Next GPUI" Target="[INSTALLFOLDER]xenterm.exe"
              WorkingDirectory="INSTALLFOLDER" Icon="ProductIcon"/>
            <RemoveFolder Id="RemoveProductMenu" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\XenTerm-Next\GPUI\Installer"
              Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder">
        <Component Id="DesktopShortcut" Guid="DA465783-EC92-4593-889F-BFAAC2C652D6" Win64="yes">
          <Shortcut Id="DesktopLink" Name="XenTerm-Next GPUI" Target="[INSTALLFOLDER]xenterm.exe"
            WorkingDirectory="INSTALLFOLDER" Icon="ProductIcon"/>
          <RegistryValue Root="HKCU" Key="Software\XenTerm-Next\GPUI\Installer"
            Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes"/>
        </Component>
      </Directory>
    </Directory>
    <Feature Id="MainProgram" Title="XenTerm-Next GPUI" Level="1">
      <ComponentGroupRef Id="GPUIFiles"/>
      <ComponentRef Id="MenuShortcut"/><ComponentRef Id="DesktopShortcut"/><ComponentRef Id="ProgramsCleanup"/>
    </Feature>
    <CustomAction Id="SetInstallLocation" Property="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]"/>
    <InstallExecuteSequence><Custom Action="SetInstallLocation" After="CostFinalize">NOT REMOVE</Custom></InstallExecuteSequence>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER"/>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)"/>
    <UIRef Id="WixUI_InstallDir"/><UIRef Id="WixUI_ErrorProgressText"/>
  </Product>
</Wix>
